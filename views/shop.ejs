<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aurora</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@200;300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"/>
</head>
<body>
     <header class="sticky top-0 z-50 bg-[#f5f1eb] border-b border-[#ded6cb]">
    <nav class=" max-w-[1500px] mx-auto px-6 lg:px-12 py-5 flex items-center justify-between">

      <a href="/" class="text-2xl font-semibold tracking-[0.25em]">
        AURORA
      </a>

      <div class="hidden md:flex items-center gap-8 text-sm">
        <a href="/shop">Home</a>
        <a href="/shop">Shop</a>
        <a href="/cart">Cart</a>
        <a href="/about">Admin</a>
        <a href="/contact">About us</a>
      </div>

      <div class="flex items-center gap-5 text-xl">
        <button aria-label="Search"><i class="fa-solid fa-magnifying-glass"></i></button>
        <a href="/views/cart.ejs" aria-label="Cart"><i class="fa-solid fa-cart-shopping"></i></a>
      </div>

    </nav>
  </header>
  <section class="max-w-[1500px] mx-auto px-6 lg:px-12 py-10">
    <p class="text-xs tracking-[0.25em] text-stone-500 mb-2">
      OUR COLLECTIONS
    </p>

    <h1 class="text-4xl md:text-5xl font-semibold">Shop</h1>

    <p class="text-sm text-stone-500 mt-3">
      Premium quality clothing, crafted for your everyday style.
    </p>
  </section>
  <main class="max-w-[1500px] mx-auto px-6 lg:px-12 pb-16">

    <div class="grid grid-cols-1 lg:grid-cols-[230px_minmax(0,1fr)] gap-8">

      <aside class="border-b lg:border-b-0 lg:border-r border-[#ded6cb] pb-6 lg:pr-7">

        <div class="flex items-center justify-between mb-7">
          <h2 class="text-sm font-semibold tracking-[0.2em]">FILTERS</h2>
          <button class="text-xs text-stone-500 underline">Clear all</button>
        </div>
        <div class="border-b border-[#ded6cb] pb-6 mb-7">
          <h3 class="text-xs font-semibold tracking-widest mb-4">CATEGORY</h3>

          <label class="flex items-center gap-3 mb-3 text-sm">
            <input type="checkbox" class="accent-[#302a25]">
            Hoodies (12)
          </label>

          <label class="flex items-center gap-3 mb-3 text-sm">
            <input type="checkbox" class="accent-[#302a25]">
            T-Shirts (15)
          </label>

          <label class="flex items-center gap-3 mb-3 text-sm">
            <input type="checkbox" class="accent-[#302a25]">
            Sweatshirts (8)
          </label>

          <label class="flex items-center gap-3 mb-3 text-sm">
            <input type="checkbox" class="accent-[#302a25]">
            Jackets (6)
          </label>

          <label class="flex items-center gap-3 text-sm">
            <input type="checkbox" class="accent-[#302a25]">
            Accessories (5)
          </label>
        </div>
        <div class="border-b border-[#ded6cb] pb-6 mb-7">
          <h3 class="text-xs font-semibold tracking-widest mb-4">SIZE</h3>

          <label class="flex items-center gap-3 mb-3 text-sm">
            <input type="checkbox" class="accent-[#302a25]"> S
          </label>

          <label class="flex items-center gap-3 mb-3 text-sm">
            <input type="checkbox" class="accent-[#302a25]"> M
          </label>

          <label class="flex items-center gap-3 mb-3 text-sm">
            <input type="checkbox" class="accent-[#302a25]"> L
          </label>

          <label class="flex items-center gap-3 mb-3 text-sm">
            <input type="checkbox" class="accent-[#302a25]"> XL
          </label>

          <label class="flex items-center gap-3 text-sm">
            <input type="checkbox" class="accent-[#302a25]"> XXL
          </label>
        </div>
        <div class="border-b border-[#ded6cb] pb-6 mb-7">
          <h3 class="text-xs font-semibold tracking-widest mb-4">COLOR</h3>

          <div class="flex gap-3">
            <button aria-label="Black" class="w-6 h-6 rounded-full bg-black"></button>
            <button aria-label="Grey" class="w-6 h-6 rounded-full bg-gray-400"></button>
            <button aria-label="Beige" class="w-6 h-6 rounded-full bg-[#c4b19a]"></button>
            <button aria-label="Olive" class="w-6 h-6 rounded-full bg-[#555b3e]"></button>
            <button aria-label="Cream" class="w-6 h-6 rounded-full bg-[#eee6d9] border border-stone-300"></button>
          </div>
        </div>
        <div class="mb-7">
          <h3 class="text-xs font-semibold tracking-widest mb-4">PRICE</h3>

          <input type="range" min="15" max="100" value="100"
                 class="w-full accent-[#302a25]">

          <div class="flex justify-between text-xs text-stone-500 mt-2">
            <span>$15</span>
            <span>$100</span>
          </div>
        </div>

        <button class="w-full bg-[#302a25] text-white rounded-md py-3 text-sm hover:bg-[#51463b]">
          Apply Filters
        </button>

      </aside>
      <section class="min-w-0">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-7">

          <p class="text-sm text-stone-500">24 products</p>

          <div class="flex flex-col sm:flex-row gap-3">
            <input
              type="search"
              placeholder="Search products..."
              class="border border-[#ded6cb] bg-transparent rounded-full px-5 py-3 text-sm outline-none focus:border-[#302a25]"
            >

            <select class="border border-[#ded6cb] bg-transparent rounded-full px-4 py-3 text-sm outline-none">
              <option>Featured</option>
              <option>Price: Low to High</option>
              <option>Price: High to Low</option>
              <option>Name: A to Z</option>
            </select>
          </div>

        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-x-5 gap-y-9">
          <article class="group min-w-0">
            <div class="relative overflow-hidden rounded-sm bg-[#e8e0d5]">
              <img src="" alt="" class="aspect-[4/5] w-full object-cover">
              <button aria-label="Add to wishlist" class="absolute top-3 right-3 text-2xl">♡</button>
            </div>
            <h3 class="text-sm font-medium mt-3">Classic Hoodie</h3>
            <p class="text-sm mt-2">$45.00</p>
            <button class="w-full mt-3 bg-[#302a25] text-white rounded-md py-2.5 text-xs hover:bg-[#51463b]">Add to Cart</button>
          </article>
          <article class="group min-w-0">
            <div class="relative overflow-hidden rounded-sm bg-[#e8e0d5]">
              <img src="" alt="" class="aspect-[4/5] w-full object-cover">
              <button aria-label="Add to wishlist" class="absolute top-3 right-3 text-2xl">♡</button>
            </div>
            <h3 class="text-sm font-medium mt-3">Basic T-Shirt</h3>
            <p class="text-sm mt-2">$25.00</p>
            <button class="w-full mt-3 bg-[#302a25] text-white rounded-md py-2.5 text-xs hover:bg-[#51463b]">Add to Cart</button>
          </article>
          <article class="group min-w-0">
            <div class="relative overflow-hidden rounded-sm bg-[#e8e0d5]">
              <img src="" alt="" class="aspect-[4/5] w-full object-cover">
              <button aria-label="Add to wishlist" class="absolute top-3 right-3 text-2xl">♡</button>
            </div>
            <h3 class="text-sm font-medium mt-3">Minimal Sweatshirt</h3>
            <p class="text-sm mt-2">$35.00</p>
            <button class="w-full mt-3 bg-[#302a25] text-white rounded-md py-2.5 text-xs hover:bg-[#51463b]">Add to Cart</button>
          </article>
          <article class="group min-w-0">
            <div class="relative overflow-hidden rounded-sm bg-[#e8e0d5]">
              <img src="" alt="" class="aspect-[4/5] w-full object-cover">
              <button aria-label="Add to wishlist" class="absolute top-3 right-3 text-2xl">♡</button>
            </div>
            <h3 class="text-sm font-medium mt-3">Light Jacket</h3>
            <p class="text-sm mt-2">$65.00</p>
            <button class="w-full mt-3 bg-[#302a25] text-white rounded-md py-2.5 text-xs hover:bg-[#51463b]">Add to Cart</button>
          </article>
          <article class="group min-w-0">
            <div class="relative overflow-hidden rounded-sm bg-[#e8e0d5]">
              <img src="" alt="" class="aspect-[4/5] w-full object-cover">
              <button aria-label="Add to wishlist" class="absolute top-3 right-3 text-2xl">♡</button>
            </div>
            <h3 class="text-sm font-medium mt-3">Essential Hoodie</h3>
            <p class="text-sm mt-2">$48.00</p>
            <button class="w-full mt-3 bg-[#302a25] text-white rounded-md py-2.5 text-xs hover:bg-[#51463b]">Add to Cart</button>
          </article>

          <article class="group min-w-0">
            <div class="relative overflow-hidden rounded-sm bg-[#e8e0d5]">
              <img src="" alt="" class="aspect-[4/5] w-full object-cover">
              <button aria-label="Add to wishlist" class="absolute top-3 right-3 text-2xl">♡</button>
            </div>
            <h3 class="text-sm font-medium mt-3">Crewneck Sweatshirt</h3>
            <p class="text-sm mt-2">$32.00</p>
            <button class="w-full mt-3 bg-[#302a25] text-white rounded-md py-2.5 text-xs hover:bg-[#51463b]">Add to Cart</button>
          </article>

          <article class="group min-w-0">
            <div class="relative overflow-hidden rounded-sm bg-[#e8e0d5]">
              <img src="" alt="" class="aspect-[4/5] w-full object-cover">
              <button aria-label="Add to wishlist" class="absolute top-3 right-3 text-2xl">♡</button>
            </div>
            <h3 class="text-sm font-medium mt-3">Classic Cap</h3>
            <p class="text-sm mt-2">$20.00</p>
            <button class="w-full mt-3 bg-[#302a25] text-white rounded-md py-2.5 text-xs hover:bg-[#51463b]">Add to Cart</button>
          </article>
          <article class="group min-w-0">
            <div class="relative overflow-hidden rounded-sm bg-[#e8e0d5]">
              <img src="" alt="" class="aspect-[4/5] w-full object-cover">
              <button aria-label="Add to wishlist" class="absolute top-3 right-3 text-2xl">♡</button>
            </div>
            <h3 class="text-sm font-medium mt-3">Everyday Joggers</h3>
            <p class="text-sm mt-2">$40.00</p>
            <button class="w-full mt-3 bg-[#302a25] text-white rounded-md py-2.5 text-xs hover:bg-[#51463b]">Add to Cart</button>
          </article>

        </div>
      </section>

    </div>
  </main>
    </div>
</body>
</html>